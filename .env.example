# Environment variables used by the application.
# Copy this file to .env for local overrides.
#
# Angular server port. Defaults to 4000 when unset.
PORT=4000

# Datasul authentication gateway. Do not place real user credentials here.
DATASUL_BASE_URL=http://10.101.195.111:51080
DATASUL_SECURITY_PROGRAM=fcq-0001
DATASUL_REQUEST_TIMEOUT_MS=10000

# Technical account used only by the server-side Plano de Controle CQ gateway.
# Inject real credentials through the deployment platform; never expose them in
# Angular environment files, browser bundles or source control.
DATASUL_COMPANY_ID=1
DATASUL_INTEGRATION_USER=
DATASUL_INTEGRATION_PASSWORD=

# Application-owned session. Supply the real secret through the deployment
# platform/process manager; never commit it to the repository. It must contain
# at least 32 UTF-8 bytes; the placeholder below is intentionally rejected.
APP_AUTH_TOKEN_SECRET=replace-with-a-managed-secret
APP_AUTH_TOKEN_TTL_MS=28800000

# Zero disables offline continuity until an approved policy is configured.
APP_OFFLINE_SESSION_TTL_MS=0

# Server-side logs. Relative APP_LOG_DIR paths are resolved from the directory
# where Node is started. Logs never contain request bodies or credentials.
APP_LOG_LEVEL=info
APP_LOG_DIR=logs
APP_LOG_RETENTION_DAYS=14
APP_LOG_MAX_SIZE=20m
