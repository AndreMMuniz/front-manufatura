# Environment variables used by the application.
# Copy this file to .env for local overrides.
#
# The application does not require LLM/AI provider keys at runtime.

# Angular server port. Defaults to 4000 when unset.
PORT=4000

# Credentials used by the external validation login.
# Set these values as Vercel Environment Variables in Production/Preview.
APP_LOGIN_USER=operador
APP_LOGIN_PASSWORD=mock123
APP_LOGIN_NAME="Operador Cortag"
